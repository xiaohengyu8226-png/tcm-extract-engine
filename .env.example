# ══════════════════════════════════════════════════════════════
# 复制本文件为 .env 并填入真实值：  cp .env.example .env
# 注意：.env 已在 .gitignore 中，切勿提交任何真实密钥。
# ══════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
# 全局默认模型（三模型未显式配置时的回退值）
# ══════════════════════════════════════════════════════════════
OPENAI_MODEL=
OPENAI_BASE_URL=https://your-llm-endpoint/v1
OPENAI_API_KEY=

# ── 提示词生成模型（低频高创造力，推荐 deepseek-chat / qwen-plus）────────
# 未设置时回退到 OPENAI_* 全局默认
PROMPT_MODEL=
# PROMPT_BASE_URL=
# PROMPT_API_KEY=
# PROMPT_TIMEOUT=600
# PROMPT_MAX_TOKENS=65536
PROMPT_THINKING_ENABLED=0

# ── 抽取模型（高频主力，推荐 deepseek-v4-flash / qwen-turbo）──────────
# 未设置时回退到 OPENAI_* 全局默认
EXTRACT_MODEL=
# EXTRACT_BASE_URL=
# EXTRACT_API_KEY=
# EXTRACT_TIMEOUT=600
# EXTRACT_MAX_TOKENS=65536
EXTRACT_THINKING_ENABLED=0

# ── 校验模型（含校对+结果验证，推荐 deepseek-chat + thinking）────────
# 未设置时回退到 OPENAI_* 全局默认
# 校验模型 B 建议与抽取模型 A 不同源，避免自己给自己盖章
VERIFY_MODEL=
VERIFY_BASE_URL=http://127.0.0.1:15001/v1
VERIFY_API_KEY=
# VERIFY_TIMEOUT=600
# VERIFY_MAX_TOKENS=65536
VERIFY_THINKING_ENABLED=1
# 校验批次并发数：贴着服务端真实准入数设置，过大只会让队尾叠破 VERIFY_TIMEOUT
VERIFY_CONCURRENCY=4

# ── LLM 并发与批次（三阶段共用信号量） ─────────────────────────────
LLM_CONCURRENCY=200
LLM_BATCH_SIZE=2
# 单批送模型的最大字符数：超出则按语义边界切开分块，避免整张表灌进单次请求撞截断/超时
LLM_MAX_BATCH_CHARS=20000
LLM_MAX_TOKENS=65536
PROOFREAD_BATCH_SIZE=8

# 最大并发 in-flight 任务数（保护内存，三层信号量的 master 层）
PDF2EXCEL_MAX_CONCURRENT=3

# ── MinerU 长驻服务配置 ─────────────────────────────────────────
MINERU_SERVER_HOST=127.0.0.1
MINERU_SERVER_PORT=8681
# 同时调用 MinerU 解析的并发数（保护 GPU/显存，三层信号量的 parse 层）
# 必须保持为 1：hybrid-engine 的 vLLM 引擎是进程级单例，LLM.generate() 非线程安全，
# 且同步 do_parse 路径没有执行守卫；>1 会触发崩溃并陷入「失败→整份重跑→再失败」循环。
# 真正并行请走多进程/多 GPU 服务化。
MINERU_MAX_CONCURRENT_PARSE=1
# MinerU 设备模式：cuda（GPU 加速）/ cpu
MINERU_DEVICE_MODE=cuda
CUDA_VISIBLE_DEVICES=0

# 后端选择：同名键 dotenv 取最后一个，重复定义会让读到的值与预期相反
# Hybrid 必须 high，medium 会强制关闭图片分析
MINERU_BACKEND=
MINERU_IMAGE_ANALYSIS=true
MINERU_HYBRID_EFFORT=high
# hybrid/vlm-engine 解析失败时是否自动降级到 pipeline backend（更稳定但效果可能稍差）
MINERU_FALLBACK_TO_PIPELINE=1
# vLLM 引擎的显存预算比例：按总显存算，留空则沿用 MinerU 默认
MINERU_VLM_GPU_MEMORY_UTILIZATION=0.1

# ── Neo4j 配置 ──────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

TCM_KG_WORKSPACE=
TCM_RAG_EMBEDDING_BACKEND=hash
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

# ── 本地 vLLM 端点（可选） ──────────────────────────────────────
VLLM_BASE_URL=http://127.0.0.1:15001/v1
VLLM_MODEL=
VLLM_API_KEY=
VLLM_TIMEOUT=180
VLLM_MAX_CONCURRENCY=2
VLLM_TEMPERATURE=0.1
MAX_EVIDENCE_CHARS=12000
